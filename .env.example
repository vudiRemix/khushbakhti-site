# Скопируйте в .env.local для запуска на компьютере; на хостинге задайте те же переменные в настройках сайта.
# Подробно: docs/DEPLOY.md

# Пароль админки (/admin), не короче 12 символов. Обязателен на хостинге; без него вход закрыт.
ADMIN_PASSWORD=

# Адрес сайта для QR-кодов, карты сайта и превью ссылок, например https://khushbakhti.netlify.app
SITE_URL=

# Supabase: база меню и фото. Без них сайт показывает встроенное меню, а админка не сохраняет изменения.
# Секретный ключ sb_secret_… (Settings → API Keys). Старый ключ service_role тоже подойдёт.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Cloud Translation: автоперевод новых блюд на тоҷикӣ, English и 中文. Без ключа переводы вводятся вручную.
GOOGLE_TRANSLATE_API_KEY=

# Необязательно: секрет для подписи входа в админку (по умолчанию используется секретный ключ Supabase).
SESSION_SECRET=
